    "businessObjectives": [
      {
        "id": "obj-1",
        "title": "Establish German market beachhead",
        "description": "Acquire 40 mid-market German retail logos within 24 months of launch."
      },
      {
        "id": "obj-2",
        "title": "Localise product for DE retail ops",
        "description": "Ship German UI, DATEV/ERP connectors, and SEPA-native billing by month 9."
      },
      {
        "id": "obj-3",
        "title": "Achieve positive contribution margin",
        "description": "Reach break-even on German P&L within 30 months at base-case penetration."
      },
      {
        "id": "obj-4",
        "title": "Build trusted local brand",
        "description": "Secure two industry analyst mentions and three reference customers in DE by month 18."
      },
      {
        "id": "obj-5",
        "title": "Regulatory readiness",
        "description": "Complete GDPR DPIA, data residency options in Frankfurt, and works-council playbook before first enterprise close."
      },
      {
        "id": "obj-6",
        "title": "DACH platform for expansion",
        "description": "Use Germany as the operating template for Austria and Switzerland entry in year 3."
      }
    ]
  },
